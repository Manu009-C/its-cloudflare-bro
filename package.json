{
  "name": "its-cloudflare-bro",
  "version": "0.1.0",
  "description": "A parody React component that renders a fake Cloudflare-style error page.",
  "author": "Manu009-C",
  "license": "MIT",
  "homepage": "https://github.com/Manu009-C/its-cloudflare-bro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manu009-C/its-cloudflare-bro.git"
  },
  "keywords": [
    "react",
    "cloudflare",
    "error-page",
    "parody",
    "joke",
    "component",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo": "VITE_ITS_CLOUDFLARE_BRO_DEMO=true vite",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}

